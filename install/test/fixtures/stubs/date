#!/bin/sh
# Test stand-in for date: the real date at a fixed moment, the epoch seconds in
# $STUB_STATE/now (0 when that file is missing). TZ and the format pass through.
now="$(cat "${STUB_STATE:?}/now" 2>/dev/null || echo 0)"
if /bin/date -d @0 >/dev/null 2>&1; then
    exec /bin/date -d "@$now" "$@"
fi
exec /bin/date -r "$now" "$@"
