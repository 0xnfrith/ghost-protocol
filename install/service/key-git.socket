# The git sign-in socket (gp-key-<name>-git.socket) of the Ghost Protocol
# instance @NAME@: the relay's git sign-in, served by its key service.
# install/keyservice/setup makes it from install/service/key-git.socket and
# installs it in /etc/systemd/system.
#
# Each connection starts one gp-key-@NAME@-git@.service as the key's user,
# with the connection as its stdin and stdout: one request, one answer. The
# session's side is git's credential helper, adapters/buzz/src/git-credential.mjs,
# which setup names in the instance user's git settings for the relay's
# address: it holds no key.
#
# Only root and the group @AGENT_GROUP@ (the instance's own user's group, which
# holds no other user) can connect. Up to 8 at once.

[Unit]
Description=Ghost Protocol instance @NAME@: the key service's git sign-in socket

[Socket]
ListenStream=@RUN@/git.sock
Accept=yes
MaxConnections=8
SocketUser=root
SocketGroup=@AGENT_GROUP@
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
