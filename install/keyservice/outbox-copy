#!/usr/bin/python3 -I
# outbox-copy: the key service's copy step. It moves the files the session put
# in its outbox into the folder buzz-mcp sends from (BUZZ_MCP_ROOT).
#
# Usage: outbox-copy <outbox> <files> [<max bytes> [<max files> [<max total bytes>]]]
#
# Why: buzz-mcp checks a path argument with realpath and then opens it, so
# whoever can write in its root could swap a file for a link between the two
# steps. So the root (<files>) is the key's user's alone, and the session
# writes only into <outbox>. gp-key-<name>-outbox.service runs this as the
# key's user whenever the outbox changes. It is never given the key.
#
# What it takes: each entry at the top of <outbox> whose name does not start
# with a dot, and is made of letters, digits, spaces and . _ + = , @ ( ) -
# (at most 200), opened without following a link (O_NOFOLLOW) and without
# waiting (O_NONBLOCK, so a FIFO cannot hold it up), and only when it is a
# regular file with one link (no hard link to anything else) and at most
# <max bytes> (default 64 MiB). A file changed in the last two seconds, or
# while it was copied, waits for the next pass. Each taken file is copied to
# <files>/<name> (mode 0640, replacing one of that name) and then removed from
# the outbox, if that name still holds the same file. Anything else is left
# where it is, with one line saying why. To send a file, write it under a name
# starting with a dot, then rename it, so a half-written file is never taken.
#
# The files folder has a quota: at most <max files> files (default 1000) and
# <max total bytes> in all (default 1 GiB). A file that would go over it is
# left, with its line, until older files are removed. It also removes files
# in <files> older than seven days, so the folder does not fill up. Every line it prints is fixed words and a checked name, never a
# file's content.
#
# Exit codes: 0 done (some files may have been left, each with its line);
# 1 a folder could not be opened; 2 usage.
import errno
import os
import re
import stat
import sys
import time

NAME = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9 ._+=,@()-]{0,199}$")
DEFAULT_MAX = 64 * 1024 * 1024
DEFAULT_MAX_FILES = 1000
DEFAULT_MAX_TOTAL = 1024 * 1024 * 1024
KEEP_SECONDS = 7 * 24 * 3600
SETTLE_SECONDS = 2
PASSES = 5
CHUNK = 1024 * 1024
DIR_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
FILE_FLAGS = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_NOCTTY | os.O_CLOEXEC


def say(text):
    print("outbox-copy: " + text, flush=True)


def prune(files_fd):
    now = time.time()
    for name in os.listdir(files_fd):
        try:
            st = os.stat(name, dir_fd=files_fd, follow_symlinks=False)
        except OSError:
            continue
        old = now - st.st_mtime
        stale_part = name.startswith(".in-") and old > 3600
        if stat.S_ISREG(st.st_mode) and (old > KEEP_SECONDS or stale_part):
            try:
                os.unlink(name, dir_fd=files_fd)
                if not stale_part:
                    say("removed %s from the files folder (older than seven days)" % name)
            except OSError:
                pass


def usage_now(files_fd):
    """The files folder's regular files: how many, and their bytes in all."""
    count = total = 0
    for entry in os.listdir(files_fd):
        try:
            st = os.stat(entry, dir_fd=files_fd, follow_symlinks=False)
        except OSError:
            continue
        if stat.S_ISREG(st.st_mode):
            count += 1
            total += st.st_size
    return count, total


def size_in(files_fd, name):
    """The size of the regular file <name> in the files folder (one a copy would replace), or None."""
    try:
        st = os.stat(name, dir_fd=files_fd, follow_symlinks=False)
    except OSError:
        return None
    return st.st_size if stat.S_ISREG(st.st_mode) else None


def take(name, outbox_fd, files_fd, limit, room):
    """'done', 'left' (with its line printed) or 'later' (try the next pass).
    room: the quota, {"files", "total", "max_files", "max_total"}, kept up to date."""
    if not NAME.match(name):
        say("left an entry whose name is not a plain file name (letters, digits, spaces and . _ + = , @ ( ) -)")
        return "left"
    try:
        fd = os.open(name, FILE_FLAGS, dir_fd=outbox_fd)
    except OSError as e:
        if e.errno == errno.ELOOP:
            say("left %s: a link, not a file; links are never followed" % name)
        else:
            say("left %s: could not open it (%s)" % (name, os.strerror(e.errno)))
        return "left"
    tmp = None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            say("left %s: not a regular file" % name)
            return "left"
        if st.st_nlink != 1:
            say("left %s: it has other hard links" % name)
            return "left"
        if st.st_size > limit:
            say("left %s: %d bytes, over the limit of %d" % (name, st.st_size, limit))
            return "left"
        replaced = size_in(files_fd, name)
        files_after = room["files"] + (0 if replaced is not None else 1)
        total_after = room["total"] - (replaced or 0) + st.st_size
        if files_after > room["max_files"]:
            say("left %s: the files folder holds %d files, its limit" % (name, room["files"]))
            return "left"
        if total_after > room["max_total"]:
            say("left %s: the files folder would hold %d bytes, over its limit of %d" % (name, total_after, room["max_total"]))
            return "left"
        if time.time() - st.st_mtime < SETTLE_SECONDS:
            return "later"
        tmp = ".in-%d-%s" % (os.getpid(), name)
        out = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o640, dir_fd=files_fd)
        size = 0
        try:
            while True:
                chunk = os.read(fd, CHUNK)
                if not chunk:
                    break
                size += len(chunk)
                if size > limit:
                    break
                os.write(out, chunk)
            os.fchmod(out, 0o640)
            os.fsync(out)
        finally:
            os.close(out)
        after = os.fstat(fd)
        if size > limit or after.st_size != st.st_size or after.st_mtime_ns != st.st_mtime_ns or size != st.st_size:
            os.unlink(tmp, dir_fd=files_fd)
            tmp = None
            return "later"
        os.rename(tmp, name, src_dir_fd=files_fd, dst_dir_fd=files_fd)
        tmp = None
        try:
            now = os.stat(name, dir_fd=outbox_fd, follow_symlinks=False)
            if (now.st_dev, now.st_ino) == (st.st_dev, st.st_ino):
                os.unlink(name, dir_fd=outbox_fd)
        except OSError:
            pass
        room["files"] = files_after
        room["total"] = total_after
        say("ready to send: %s (%d bytes)" % (name, size))
        return "done"
    except OSError as e:
        say("left %s: the copy failed (%s)" % (name, os.strerror(e.errno)))
        return "left"
    finally:
        os.close(fd)
        if tmp is not None:
            try:
                os.unlink(tmp, dir_fd=files_fd)
            except OSError:
                pass


def main(argv):
    if len(argv) not in (3, 4, 5, 6):
        print("usage: outbox-copy <outbox> <files> [<max bytes> [<max files> [<max total bytes>]]]", file=sys.stderr)
        return 2
    numbers = [DEFAULT_MAX, DEFAULT_MAX_FILES, DEFAULT_MAX_TOTAL]
    for i, arg in enumerate(argv[3:]):
        if not arg.isdigit():
            print("outbox-copy: <max bytes>, <max files> and <max total bytes> must be whole numbers", file=sys.stderr)
            return 2
        numbers[i] = int(arg)
    limit = numbers[0]
    try:
        outbox_fd = os.open(argv[1], DIR_FLAGS)
        files_fd = os.open(argv[2], DIR_FLAGS)
    except OSError as e:
        say("could not open the outbox or the files folder (%s)" % os.strerror(e.errno))
        return 1
    prune(files_fd)
    count, total = usage_now(files_fd)
    room = {"files": count, "total": total, "max_files": numbers[1], "max_total": numbers[2]}
    left = set()
    for n in range(PASSES):
        waiting = False
        for name in sorted(os.listdir(outbox_fd)):
            if name.startswith(".") or name in left:
                continue
            result = take(name, outbox_fd, files_fd, limit, room)
            if result == "later":
                waiting = True
            elif result == "left":
                left.add(name)
        if not waiting:
            break
        if n + 1 < PASSES:
            time.sleep(SETTLE_SECONDS)
        else:
            say("some files were still changing; they wait for the next change in the outbox")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
