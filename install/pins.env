# pins.env: the exact versions and sha256 values the installer downloads, and
# the git it needs (a minimum version and the signing key of its apt source).
# Sourced by the installer. Every line is a comment, a blank line or
# KEY="value". Changing a pin is a reviewed pull request.

# GitHub CLI, for token mode only. Release assets of github.com/cli/cli
# v2.102.0; each value is the sha256 of the asset named in the key
# (gh_<version>_macOS_arm64.zip, gh_<version>_linux_amd64.tar.gz,
# gh_<version>_linux_arm64.tar.gz).
GH_VERSION="2.102.0"
GH_SHA256_MACOS_ARM64="da922c20d1792e5b2cbf375593d7a658acf034c12c84e007e71c76ef959c337e"
GH_SHA256_LINUX_AMD64="bb766f710eef8ede859c18578c72c327597cd4c8a85b06001b1f3843c6019386"
GH_SHA256_LINUX_ARM64="7862c86c72f43df3a2d93ddde6f473285b4e2af61b494849846827e513ef6484"

# Claude Code native build. Each sha256 is the "checksum" for that platform in
# Anthropic's release manifest for this version:
#   https://downloads.claude.ai/claude-code-releases/2.1.314/manifest.json
# (read 2026-10-31; the same address Anthropic's install.sh reads).
CLAUDE_CODE_VERSION="2.1.314"
CLAUDE_CODE_SHA256_DARWIN_ARM64="21d6e7b9a6f07b4cfcb7df13760b3b72aa25e084e13a5354413382987ba832ed"
CLAUDE_CODE_SHA256_LINUX_X64="4487042b4c4f5d88d4568f68ae98aae0b1ffae58864cf57fb868641bc5f84594"
CLAUDE_CODE_SHA256_LINUX_ARM64="a66c0a8f5d0c87a439953d797985192bbcbaefbce2e0d7b2eaa8df30ef0f3ef2"

# git. Clones of git-over-nostr repos (a Buzz relay's) need git 2.46 or newer:
# their credential helper answers only when git sends capability[]=authtype,
# which git 2.46 added. Ubuntu 24.04's own git is 2.43, so on Ubuntu boot.sh
# takes git from the Git stable PPA (ppa:git-core/ppa, run by Ubuntu's Git
# Maintainers team; git's own Linux download page sends Ubuntu users there).
# The PPA's signing key is install/apt/git-core-ppa.asc, the key published on
# keyserver.ubuntu.com for the fingerprint below (read 2026-11-03); boot.sh
# checks the file against this fingerprint before apt is told to trust it.
GIT_MIN_VERSION="2.46"
GIT_PPA_FINGERPRINT="F911AB184317630C59970973E363C90F8F1B6217"

# github.com's SSH host keys (the installer's deploykey mode) are pinned in
# install/github-known-hosts, in the known_hosts form ssh reads.

# The blackout agent's tools (tools/blackout/). These are minimum versions,
# checked and never downloaded: the installer's tools step and
# `tools/blackout/blackout.py doctor` report a tool that is missing or older,
# with the line that installs it from the system's package manager.
BLACKOUT_PYTHON_MIN_VERSION="3.9"
BLACKOUT_IMAGEMAGICK_MIN_VERSION="6.9.10"
BLACKOUT_TESSERACT_MIN_VERSION="4.1.0"
