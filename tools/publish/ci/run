#!/usr/bin/env bash
# The publish workflow's step (.github/workflows/publish.yml): publishes this clone's main to the public repository.
# Runs from the root of a full clone, with:
#   GP_PUBLISH_TOKEN  a push credential for the target repository and for nothing else
#   GP_PUBLISH_REPO   the target, owner/name
#   GP_PUBLISH_HOST   (optional) the host of the target, default github.com
# The workflow runs this once per target (the staging copy, the public repository), each time with that target's own two values.
# The token goes to git in its environment, as an extra header for the target's host only: it is never in a command line, a URL,
# a file or the log. The publish is a plain push, never a force; see tools/publish/publish.
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

: "${GP_PUBLISH_TOKEN:?GP_PUBLISH_TOKEN is not set}"
: "${GP_PUBLISH_REPO:?GP_PUBLISH_REPO is not set}"
host=${GP_PUBLISH_HOST:-github.com}
[[ $GP_PUBLISH_REPO =~ ^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9._-]+$ ]] || { echo "publish: GP_PUBLISH_REPO is not owner/name" >&2; exit 2; }
[[ $host =~ ^[A-Za-z0-9][A-Za-z0-9.-]*(:[0-9]+)?$ ]] || { echo "publish: GP_PUBLISH_HOST is not a host name" >&2; exit 2; }
[[ $GP_PUBLISH_TOKEN =~ ^[A-Za-z0-9_.-]+$ ]] || { echo "publish: GP_PUBLISH_TOKEN has a character that a token does not" >&2; exit 2; }

# This clone must be the whole history of main, at the commit that was pushed.
if [ "$(git rev-parse --is-shallow-repository)" != false ]; then
  echo "publish: the clone is shallow; the workflow checks out with fetch-depth 0" >&2
  exit 2
fi

# The credential, for this host only, in git's environment.
auth=$(printf 'x-access-token:%s' "$GP_PUBLISH_TOKEN" | base64 -w0)
export GIT_CONFIG_COUNT=1
export GIT_CONFIG_KEY_0="http.https://$host/.extraheader"
export GIT_CONFIG_VALUE_0="Authorization: Basic $auth"
unset GIT_TRACE GIT_TRACE_CURL GIT_CURL_VERBOSE GIT_TRACE_PACKET

exec "$here/../publish" --apply --branch main --ref HEAD "https://$host/$GP_PUBLISH_REPO.git"
